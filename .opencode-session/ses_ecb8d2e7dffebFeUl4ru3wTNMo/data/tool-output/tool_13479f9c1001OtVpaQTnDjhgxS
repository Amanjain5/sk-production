<script>
  function initPreloader() {
    var HERO_VIDEO_SELECTOR = '.hero_bg_wrap video.u-video';
    var RAMP_DURATION = 0.4;
    var COUNT_DURATION = 1.6;

    var loadingContainer = document.querySelector('.loading-container');
    var loadingScreen = document.querySelector('.loading-screen');
    if (!loadingContainer || !loadingScreen) return;

    var hasGsap = typeof gsap !== 'undefined';
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!hasGsap || !window.LoaderGate) {
      reveal();
      return;
    }

    var gateSignals = {
      pageLoaded: false,
      videoReady: false,
      fontsReady: false,
      videoError: false,
      initReady: false,
    };
    var gateAlreadyResolved = false;

    function digitOffset(digit) {
      var normalized = digit === 0 ? 10 : digit;
      return (normalized - 1) * -10;
    }

    var pageReleased = false;
    function releasePage() {
      // Unlock scroll + hand the page over the moment the load gate is
      // satisfied — everything after this point (bar to 100% + fade)
      // is purely cosmetic, and holding the lock through it added
      // ~1.6s of "hero visible but frozen". Idempotent on purpose:
      // called from finish() (normal path) AND reveal() (no-GSAP path).
      if (pageReleased) return;
      pageReleased = true;

      // The scroll-lock style ALSO carries `.loading-container {
      // visibility: visible !important }` — the Webflow class defaults
      // to visibility: hidden, so that rule is the only thing keeping
      // the loader on screen this late (the .anti-flicker override is
      // long gone by now). Pin visibility inline BEFORE removing the
      // style, or the loader vanishes instantly at 90% and the finish
      // animation (roll to 100% + fade) plays on an invisible element.
      loadingContainer.style.visibility = 'visible';

      var scrollLock = document.getElementById('preloader-scroll-lock');
      if (scrollLock) scrollLock.remove();

      document.dispatchEvent(new CustomEvent('preloader:complete'));
    }

    function reveal() {
      releasePage();
      loadingContainer.style.display = 'none';

      // Loader is fully gone — lift the CSS hold so the Cookiebot dialog
      // can appear. script.js already called Cookiebot.show() back at
      // `preloader:complete`; this hold is what kept the dialog invisible
      // through the finish animation (roll to 100% + hold + fade), per
      // client request that the banner only shows AFTER the preloader.
      var cookiebotHold = document.getElementById('cookiebot-preloader-hold');
      if (cookiebotHold) cookiebotHold.remove();
    }

    function finish() {
      loadingScreen.style.pointerEvents = 'none';
      releasePage();

      if (reducedMotion) {
        gsap.to(loadingContainer, {
          opacity: 0,
          duration: 0.3,
          ease: 'power1.out',
          onComplete: reveal,
        });
        return;
      }

      // One continuous count 0→100, played only once the gate is open —
      // the animation never has to chase the network, so it can't
      // stutter, jump, or park between digits. Until this runs the
      // loader sits at a static "0%".
      var finishTl = gsap.timeline({
        onComplete: reveal,
      });

      finishTl.to(shown, {
        p: 90,
        duration: COUNT_DURATION,
        ease: 'power2.inOut',
        onUpdate: renderProgress,
      });
      finishTl.to('.loading__progress-inner', {
        scaleY: 1,
        duration: RAMP_DURATION,
        ease: 'power2.inOut',
      });
      finishTl.to(
        '.loading__number-group.is--second .loading__number-wrap',
        {
          yPercent: digitOffset(0),
          duration: RAMP_DURATION,
          ease: 'power2.inOut',
        },
        '<',
      );
      finishTl.to(
        '.loading__number-group.is--first .loading__number-wrap',
        {
          yPercent: 0,
          duration: RAMP_DURATION,
          ease: 'power2.inOut',
        },
        '<',
      );
      // Hold the finished "100%" for a beat before fading — the reveal
      // shouldn't feel like it cuts the counter off mid-beat.
      finishTl.to(
        loadingContainer,
        {
          opacity: 0,
          duration: 0.5,
          ease: 'power2.out',
        },
        '+=1',
      );
    }

    function checkGate() {
      if (gateAlreadyResolved) return;
      if (!window.LoaderGate.shouldGateResolve(gateSignals)) return;
      gateAlreadyResolved = true;
      finish();
    }

    function watchVideo() {
      function videoDone(errored) {
        if (errored) {
          gateSignals.videoError = true;
        } else {
          gateSignals.videoReady = true;
        }
        checkGate();
      }

      var video = document.querySelector(HERO_VIDEO_SELECTOR);
      if (!video) {
        videoDone(false);
        return;
      }
      if (video.readyState >= 3) {
        videoDone(false);
        return;
      }
      // A failed load must not hold the gate hostage — but when the src
      // lives on <source> children (it does here), the spec fires the
      // `error` event on the LAST <source>, never on the <video> itself.
      // Listen on both, and check for an already-settled failure
      // (NETWORK_NO_SOURCE) in case it happened before this ran —
      // ad-blockers blocking player.vimeo.com are the common real case.
      if (video.networkState === 3 /* NETWORK_NO_SOURCE */ || video.error) {
        videoDone(true);
        return;
      }
      var settled = false;
      function once(errored) {
        if (settled) return;
        settled = true;
        videoDone(errored);
      }
      video.addEventListener('canplay', function () {
        once(false);
      });
      video.addEventListener('error', function () {
        once(true);
      });
      var sources = video.querySelectorAll('source');
      var lastSource = sources[sources.length - 1];
      if (lastSource) {
        lastSource.addEventListener('error', function () {
          once(true);
        });
      }
    }

    function watchFonts() {
      function fontsDone() {
        gateSignals.fontsReady = true;
        checkGate();
      }

      if (!document.fonts || !document.fonts.ready) {
        fontsDone();
        return;
      }
      document.fonts.ready.then(fontsDone);
    }

    function watchInit() {
      function initDone() {
        gateSignals.initReady = true;
        checkGate();
      }

      // script.js runs its whole init chain at window `load` (behind
      // this loader) and signals completion with a window flag + event
      // — flag first in case it finished before this listener existed.
      if (window.__mainInitDone) {
        initDone();
        return;
      }
      document.addEventListener('main-init:complete', initDone, {
        once: true,
      });
    }

    function watchPageLoad() {
      function pageLoadDone() {
        gateSignals.pageLoaded = true;
        checkGate();
      }

      // window `load` = every image, stylesheet, and script is done —
      // this is what makes the loader genuinely wait for the full page
      // instead of racing a fixed timeout.
      if (document.readyState === 'complete') {
        pageLoadDone();
        return;
      }
      window.addEventListener('load', pageLoadDone, { once: true });
    }

    // ============================================================
    // LOAD-GATED COUNT
    // No live load-tracking: chasing the real network (image counts,
    // asset weights) is what made the count jumpy — cached loads
    // teleported the bar, slow assets parked it. Instead the loader
    // sits at a static "0%" while the page genuinely loads (the gate:
    // window `load` + hero video + fonts + script.js init), then
    // finish() plays ONE pre-scripted, continuous 0→100 count — bar
    // and tens strip both derived from the same shown.p every frame
    // (odometer roll: p=0 → one slot below "1", p=10 → "1", …
    // p=90 → "9"), so they can never drift apart or stutter.
    // ============================================================

    var shown = { p: 0 };

    function renderProgress() {
      gsap.set('.loading__progress-inner', { scaleY: shown.p / 100 });
      gsap.set('.loading__number-group.is--second .loading__number-wrap', {
        yPercent: -10 * (Math.min(shown.p, 90) / 10 - 1),
      });
    }

    function initLoaderUI() {
      gsap.set(loadingScreen, {
        display: 'block',
      });
      gsap.set('.loading__progress-inner', {
        scaleY: 0,
      });
      // Waiting state reads "0%": tens strip parked one slot below "1"
      // (the count rolls it in), ones "0" and "%" visible immediately,
      // hundreds "1" hidden until the final roll to 100.
      gsap.set('.loading__number-group.is--first .loading__number-wrap', {
        yPercent: 100,
      });
      gsap.set('.loading__number-group.is--second .loading__number-wrap', {
        yPercent: 10,
      });
      gsap.set('.loading__number-group.is--third .loading__number-wrap', {
        yPercent: digitOffset(0),
      });
      gsap.set('.loading__percentage', {
        yPercent: 0,
      });
    }

    initLoaderUI();
    watchPageLoad();
    watchInit();
    watchVideo();
    watchFonts();

    // Backstop: a wedged signal (script.js dying before it dispatches
    // `main-init:complete`, a video that neither plays nor errors) must
    // not park the loader at "0%" forever. 10s after window `load` —
    // far past any healthy init — force whatever is still pending and
    // play the count.
    window.addEventListener(
      'load',
      function () {
        setTimeout(function () {
          if (gateAlreadyResolved) return;
          gateSignals.videoError = true;
          gateSignals.fontsReady = true;
          gateSignals.pageLoaded = true;
          gateSignals.initReady = true;
          checkGate();
        }, 10000);
      },
      { once: true },
    );
  }

  document.addEventListener('DOMContentLoaded', () => {
    initPreloader();
  });
</script></body></html>