<script defer>
  let lenis;
  const hasLenis = typeof window.Lenis !== "undefined";
  const hasScrollTrigger = typeof window.ScrollTrigger !== "undefined";
  function initLenis() {
    lenis = new Lenis({
      lerp: 0.14,
      wheelMultiplier: 0.95,
    });

    // Exposed on window so loader/load.js (a separate script) can stop/start
    // it in sync with the preloader — `let lenis` alone is only visible to
    // scripts that share this exact top-level scope, not to window.lenis.
    window.lenis = lenis;

    // Lock scroll for the whole preloader phase. lenis.stop() adds the
    // .lenis-stopped class, which the Lenis CSS above turns into
    // overflow: hidden — so native touch/scrollbar input is blocked
    // too, not just smooth-wheel scroll. Released by script.js via
    // lenis.start() on `preloader:complete`.
    if (document.querySelector(".loading-container")) {
      lenis.stop();
    }

    if (hasScrollTrigger) {
      lenis.on("scroll", ScrollTrigger.update);
    }

    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });

    gsap.ticker.lagSmoothing(0);
  }

  document.addEventListener("DOMContentLoaded", () => {
    initLenis();
  });

</script>
